# Copy this file to .env.local for local development.
# In production (Vercel), set these under Project Settings → Environment Variables.

# The password used to log into /admin. Pick something strong.
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Created automatically when you link a Vercel Blob store to this project:
# Vercel dashboard → your project → Storage → Create Database → Blob.
# Once linked, `vercel env pull .env.local` (or the dashboard) gives you this value.
BLOB_READ_WRITE_TOKEN=
